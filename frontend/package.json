{
  "name": "ai-example-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "vite",
    "dev:e2e": "VITE_E2E=1 vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright install chromium && playwright test --project=chromium",
    "test:e2e:headed": "playwright install chromium && PLAYWRIGHT_SLOWMO=400 playwright test --project=chromium --headed",
    "test:e2e:ui": "playwright install chromium && playwright test --project=chromium --ui",
    "test:e2e:keys": "playwright install chromium && playwright test --project=keys",
    "preview": "vite preview",
    "poster:export": "node scripts/export-poster.mjs",
    "endcard:export": "node scripts/export-poster.mjs endcard"
  },
  "dependencies": {
    "@mantine/code-highlight": "^9.5.1",
    "@mantine/core": "^9.5.1",
    "@mantine/hooks": "^9.5.1",
    "@mantine/notifications": "^9.5.1",
    "highlight.js": "^11.12.0",
    "motion": "^12.23.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-simple-vars": "^7.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.0.0"
  }
}
