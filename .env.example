# 默认 Provider：deepseek | dashscope | kimi | glm | qwen35
AI_PROVIDER=deepseek

# DeepSeek（默认，OpenAI 兼容）https://api-docs.deepseek.com/
PROVIDER_DEEPSEEK_API_KEY=sk-your-deepseek-key
# PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 未填 PROVIDER_*_API_KEY 时，默认 Provider 会回退到 AI_API_KEY
# AI_API_KEY=

# Embedding（RAG 必填）：阿里云百炼 text-embedding-v3
PROVIDER_DASHSCOPE_API_KEY=
# PROVIDER_DASHSCOPE_MODEL=qwen3.8-max

# Moonshot / Kimi
# PROVIDER_KIMI_API_KEY=
# PROVIDER_KIMI_MODEL=kimi-latest

# 智谱 GLM
# PROVIDER_GLM_API_KEY=
# PROVIDER_GLM_MODEL=glm-5

# 内网 vLLM qwen3.5（OpenAI 兼容）；注意用 KEY=value，不要写成 KEY:value
# PROVIDER_QWEN35_API_KEY=
# PROVIDER_QWEN35_MODEL=qwennaradav1

# 可选采样参数
# AI_TEMPERATURE=0.2

# PostgreSQL / pgvector。本地默认值仅供演示，非本地部署必须替换密码。
PG_DB=ai_example
PG_USER=ai
PG_PASSWORD=ai
# 调试覆盖文件发布到宿主机的端口
# POSTGRES_PORT=5432

# MCP 两端必须使用相同 Token；dev-mcp-token 仅供本地演示。
MCP_MODE=remote
MCP_CLIENT_ENABLED=true
MCP_CLIENT_INITIALIZED=false
MCP_BEARER_TOKEN=dev-mcp-token
# 宿主机运行 Java 时使用；完整 Compose 会覆盖为 http://mcp-server:8081
# MCP_REMOTE_URL=http://localhost:8081
# 调试覆盖文件发布到宿主机的端口
# MCP_PORT=8081

# jdbc=PostgreSQL 持久化；memory=进程内存储
CONTEXT_STORE=jdbc

# Flyway 在启动期建表，因此 PostgreSQL 从此是启动硬依赖（连不上就起不来）。
# 没有 Docker、只想让进程起来看看接口时设 false；此时会话表不存在，
# PRODUCTION_SESSION_ENABLED 也要一并关掉。
# FLYWAY_ENABLED=true

# Redis：工业级 SSE run 状态与断线续传。宿主机 bootRun 默认连 localhost:6379。
# 本地：docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Java 25 + Netty：消除 System.loadLibrary 受限方法 WARNING（IDE 直跑 / java -jar 时有用）
# JAVA_TOOL_OPTIONS=--enable-native-access=ALL-UNNAMED

# 工业级链路（/api/v1）；与教学样例分开。关掉后可不依赖 Redis。
# PRODUCTION_ENABLED=true
# PRODUCTION_EVENT_LOG=redis
# PRODUCTION_CORPUS=ai-example-prod

# 工业级多轮会话：依赖 Flyway 建的 prod_chat_* 两张表，FLYWAY_ENABLED=false 时须一并关闭
# PRODUCTION_SESSION_ENABLED=true
# redis=跨实例互斥；memory=单进程（多实例下等于没有锁）
# PRODUCTION_SESSION_LOCK=redis
# 送入模型的历史上限，两者取更严的那个
# PRODUCTION_SESSION_MAX_MESSAGES=20
# PRODUCTION_SESSION_TOKEN_BUDGET=2000
# 会话锁 TTL，要明显长于 PRODUCTION_STREAM_TIMEOUT，否则慢生成期间锁会自己过期
# PRODUCTION_SESSION_LOCK_TTL=6m
# seq 取号撞上主键时的重试次数
# PRODUCTION_SESSION_SEQ_RETRIES=3

# 信封加密主密钥：Base64 的 32 字节 AES-256。生成：openssl rand -base64 32
# 只放环境变量，禁止写入 prod_secret。空则 /api/v1 返回 503，教学样例不受影响。
# PRODUCTION_KEK=
# 轮换窗口内同时提供上一把，才能解开旧密文；重加密后可去掉
# PRODUCTION_KEK_PREVIOUS=
# PRODUCTION_SECRET_STORE=postgres
# PRODUCTION_KEK_ID=v1
# Prometheus 刮取 /actuator/prometheus 用的 Bearer，不要匿名放开
# PRODUCTION_METRICS_TOKEN=dev-metrics-token
# PRODUCTION_JWT_TTL=8h

# 工业级 Playwright（第四阶段，≠ 教学第四期 Hybrid RAG）
# 默认：cd frontend && pnpm test:e2e（Java 需已在 8080，且已设 PRODUCTION_KEK）
# 空检索 / ingest / 跨租户：配好 Embedding 后 pnpm test:e2e:keys
# E2E_HAS_EMBEDDING=1
# PLAYWRIGHT_BASE_URL=http://localhost:8088

# 工业级压测（第五阶段）：./loadtest/run.sh all
# 本机 k6 打 /api/v1，默认不打 Chat LLM；不进 CI。见 loadtest/README.md
# BASE_URL=http://127.0.0.1:8080/ai-example

# 工业级多实例（第六阶段）：compose 起 java-a / java-b；dev overlay 映 8080 与 8082
# 验证：docs/industrial-ha.md ； ./scripts/industrial-ha.sh
# PRODUCTION_INSTANCE_ID=local
# JAVA_A_PORT=8080
# JAVA_B_PORT=8082

# 工业级第七阶段：查询扩展默认 none；Grafana :3000；压测摘要见 loadtest/results/
# 人工验证：docs/industrial-ops.md
# PRODUCTION_QUERY_EXPANSION=none
# GRAFANA_PORT=3000
# PROMETHEUS_PORT=9090

# 限流：每租户+用户 30 次 / 60s；登录按 IP 更严
# PRODUCTION_RATE_CAPACITY=30
# PRODUCTION_RATE_WINDOW=60s
# PRODUCTION_LOGIN_CAPACITY=10
# PRODUCTION_IDEMPOTENCY_TTL=10m

# Trace：默认关闭导出。要看 Jaeger UI 时起 jaeger，并打开下面两项后再 bootRun
# OTEL_TRACING_EXPORT=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
# OTEL_SAMPLE_PROBABILITY=1.0
# JAEGER_UI_PORT=16686

# RAG：完整 Compose 默认启用；仅跑基础 Chat 时可同时关闭以下两项。
RAG_ENABLED=true
SPRING_AI_VECTORSTORE_TYPE=pgvector
# RAG_MIN_SOURCES=1
# RAG_SKIP_LLM_WHEN_EMPTY=true
# RAG_HYBRID_ENABLED=true
# RAG_RRF_K=60
# RAG_KEYWORD_TOP_K=4
# RAG_REWRITE_QUERY=false
# RAG_HYDE_ENABLED=true
# RAG_HYDE_FUSE=true
# MEMORY_EXTRACT_MAX=5

# 完整 Compose 唯一默认对外入口
FRONTEND_PORT=8088
# 调试覆盖文件把 java-a / java-b 发布到宿主机
# JAVA_A_PORT=8080
# JAVA_B_PORT=8082
