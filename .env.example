# 默认 Provider：deepseek | dashscope | kimi | glm | qwen35
AI_PROVIDER=deepseek

# DeepSeek（默认，OpenAI 兼容）https://api-docs.deepseek.com/
PROVIDER_DEEPSEEK_API_KEY=sk-your-deepseek-key
# PROVIDER_DEEPSEEK_MODEL=deepseek-v4-flash

# 未填 PROVIDER_*_API_KEY 时，默认 Provider 会回退到 AI_API_KEY
# AI_API_KEY=

# Embedding（RAG 必填）：阿里云百炼 text-embedding-v3
PROVIDER_DASHSCOPE_API_KEY=
# PROVIDER_DASHSCOPE_MODEL=qwen3.8-max

# Moonshot / Kimi
# PROVIDER_KIMI_API_KEY=
# PROVIDER_KIMI_MODEL=kimi-latest

# 智谱 GLM
# PROVIDER_GLM_API_KEY=
# PROVIDER_GLM_MODEL=glm-5

# 内网 vLLM qwen3.5（OpenAI 兼容）；注意用 KEY=value，不要写成 KEY:value
# PROVIDER_QWEN35_API_KEY=
# PROVIDER_QWEN35_MODEL=qwennaradav1

# 可选采样参数
# AI_TEMPERATURE=0.2

# PostgreSQL / pgvector。本地默认值仅供演示，非本地部署必须替换密码。
PG_DB=ai_example
PG_USER=ai
PG_PASSWORD=ai
# 调试覆盖文件发布到宿主机的端口
# POSTGRES_PORT=5432

# MCP 两端必须使用相同 Token；dev-mcp-token 仅供本地演示。
MCP_MODE=remote
MCP_CLIENT_ENABLED=true
MCP_CLIENT_INITIALIZED=false
MCP_BEARER_TOKEN=dev-mcp-token
# 宿主机运行 Java 时使用；完整 Compose 会覆盖为 http://mcp-server:8081
# MCP_REMOTE_URL=http://localhost:8081
# 调试覆盖文件发布到宿主机的端口
# MCP_PORT=8081

# jdbc=PostgreSQL 持久化；memory=进程内存储
CONTEXT_STORE=jdbc

# Redis：工业级 SSE run 状态与断线续传。宿主机 bootRun 默认连 localhost:6379。
# 本地：docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d redis
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Java 25 + Netty：消除 System.loadLibrary 受限方法 WARNING（IDE 直跑 / java -jar 时有用）
# JAVA_TOOL_OPTIONS=--enable-native-access=ALL-UNNAMED

# 工业级链路（/api/v1）；与教学样例分开。关掉后可不依赖 Redis。
# PRODUCTION_ENABLED=true
# PRODUCTION_EVENT_LOG=redis
# PRODUCTION_CORPUS=ai-example-prod

# RAG：完整 Compose 默认启用；仅跑基础 Chat 时可同时关闭以下两项。
RAG_ENABLED=true
SPRING_AI_VECTORSTORE_TYPE=pgvector
# RAG_MIN_SOURCES=1
# RAG_SKIP_LLM_WHEN_EMPTY=true
# RAG_HYBRID_ENABLED=true
# RAG_RRF_K=60
# RAG_KEYWORD_TOP_K=4
# RAG_REWRITE_QUERY=false
# RAG_HYDE_ENABLED=true
# RAG_HYDE_FUSE=true
# MEMORY_EXTRACT_MAX=5

# 完整 Compose 唯一默认对外入口
FRONTEND_PORT=8088
# 调试覆盖文件发布 Java 到宿主机的端口
# JAVA_PORT=8080
